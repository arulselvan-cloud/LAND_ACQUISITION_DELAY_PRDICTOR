# PostgreSQL + PostGIS Configuration
POSTGRES_DB=landsight_ai
POSTGRES_USER=landsight_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Database Connection URL (FastAPI / SQLAlchemy)
DATABASE_URL=postgresql://landsight_admin:your_secure_password_here@localhost:5432/landsight_ai

# Google Gemini API Configuration (for AI Administrative Action Memos)
# Obtain a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_SECONDS=12.0

